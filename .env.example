# Chave da OpenAI usada no ranking dos cortes, ganchos e legendas.
OPENAI_API_KEY=

# YouTube Shorts: Google Cloud > credencial OAuth do tipo "App para computador"
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok: TikTok for Developers > app (ou sandbox) > Client key / Client secret
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram (recomendado): token da Página do Facebook ("EAA...", não vence) e o ID da conta
# do Instagram ligada a ela (instagram_business_account.id). O vídeo sobe direto do PC.
# Alternativa: token do login do Instagram ("IG...") + Supabase abaixo.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Opcional: força o servidor (graph.instagram.com ou graph.facebook.com). Vazio = detecta pelo token.
INSTAGRAM_GRAPH_HOST=

# Só pro token do login do Instagram ("IG..."): storage temporário de onde o Instagram baixa o
# vídeo (sobe, o Instagram baixa, o app apaga). Com token da Página, deixe vazio.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=clipador-temp
